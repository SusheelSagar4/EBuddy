{
  "$defs": {
    "PlanItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "course",
            "exercise",
            "resource",
            "milestone",
            "remediation"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "course_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Id"
        },
        "exercise_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "semester_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semester Number"
        },
        "scheduled_week": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Week"
        },
        "estimated_hours": {
          "default": 0.0,
          "title": "Estimated Hours",
          "type": "number"
        },
        "reason": {
          "$ref": "#/$defs/StructuredReason"
        }
      },
      "required": [
        "item_id",
        "item_type",
        "reason"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "StructuredReason": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "target_skills": {
          "items": {
            "type": "string"
          },
          "title": "Target Skills",
          "type": "array"
        },
        "why_this": {
          "title": "Why This",
          "type": "string"
        },
        "prerequisite_for": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisite For",
          "type": "array"
        },
        "rule_compliance": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rule Compliance",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "target_skills",
        "why_this"
      ],
      "title": "StructuredReason",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "previous_plan_id": {
      "title": "Previous Plan Id",
      "type": "string"
    },
    "new_plan_id": {
      "title": "New Plan Id",
      "type": "string"
    },
    "added_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanItem"
      },
      "title": "Added Items",
      "type": "array"
    },
    "removed_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanItem"
      },
      "title": "Removed Items",
      "type": "array"
    },
    "modified_items": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Modified Items",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "previous_plan_id",
    "new_plan_id",
    "summary"
  ],
  "title": "PlanDiff",
  "type": "object"
}