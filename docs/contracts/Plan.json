{
  "$defs": {
    "PlanDiff": {
      "additionalProperties": false,
      "properties": {
        "previous_plan_id": {
          "title": "Previous Plan Id",
          "type": "string"
        },
        "new_plan_id": {
          "title": "New Plan Id",
          "type": "string"
        },
        "added_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "title": "Added Items",
          "type": "array"
        },
        "removed_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanItem"
          },
          "title": "Removed Items",
          "type": "array"
        },
        "modified_items": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Modified Items",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "previous_plan_id",
        "new_plan_id",
        "summary"
      ],
      "title": "PlanDiff",
      "type": "object"
    },
    "PlanItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "item_type": {
          "enum": [
            "course",
            "exercise",
            "resource",
            "milestone",
            "remediation"
          ],
          "title": "Item Type",
          "type": "string"
        },
        "course_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Course Id"
        },
        "exercise_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exercise Id"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "semester_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semester Number"
        },
        "scheduled_week": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled Week"
        },
        "estimated_hours": {
          "default": 0.0,
          "title": "Estimated Hours",
          "type": "number"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "prep_hours_weekly": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prep Hours Weekly"
        },
        "reason": {
          "$ref": "#/$defs/StructuredReason"
        }
      },
      "required": [
        "item_id",
        "item_type",
        "reason"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "StructuredReason": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "title": "Intent",
          "type": "string"
        },
        "target_skills": {
          "items": {
            "type": "string"
          },
          "title": "Target Skills",
          "type": "array"
        },
        "why_this": {
          "title": "Why This",
          "type": "string"
        },
        "prerequisite_for": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prerequisite For",
          "type": "array"
        },
        "rule_compliance": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rule Compliance",
          "type": "array"
        }
      },
      "required": [
        "intent",
        "target_skills",
        "why_this"
      ],
      "title": "StructuredReason",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "check_name": {
          "title": "Check Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "severity": {
          "default": "error",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "check_name",
        "passed",
        "message"
      ],
      "title": "ValidationCheck",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "messages": {
          "items": {
            "type": "string"
          },
          "title": "Messages",
          "type": "array"
        }
      },
      "required": [
        "plan_id",
        "passed",
        "checks",
        "messages"
      ],
      "title": "ValidationReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "student_id": {
      "title": "Student Id",
      "type": "string"
    },
    "goal_id": {
      "title": "Goal Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PlanItem"
      },
      "title": "Items",
      "type": "array"
    },
    "validation_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "conflict_flag": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Flag"
    },
    "optional_overload_proposals": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Optional Overload Proposals",
      "type": "array"
    },
    "plan_diff": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlanDiff"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "what_changed_and_why": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "What Changed And Why"
    },
    "mismatch_warning": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mismatch Warning"
    },
    "is_active": {
      "default": true,
      "title": "Is Active",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "student_id",
    "goal_id",
    "items",
    "created_at"
  ],
  "title": "Plan",
  "type": "object"
}