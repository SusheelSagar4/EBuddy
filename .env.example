# ==============================================================================
# Adobe Personalised Learning Buddy - Environment Configuration
# ==============================================================================

# --- LiteLLM Configuration ---
# Tested and tuned default model: openai/gpt-4o-mini
# Supported formats:
#   OpenAI:   openai/gpt-4o-mini, openai/gpt-4o
#   Gemini:   gemini/gemini-1.5-flash, gemini/gemini-1.5-pro
#   Azure:    azure/<deployment-name>
#   Ollama:   ollama/<model-name>
LLM_MODEL=openai/gpt-4o-mini

# Model Provider API Key (Required for live LLM completions; mocked during offline tests)
LLM_API_KEY=your_api_key_here

# Optional: Custom API Base URL (e.g., local LiteLLM proxy, Ollama, or Azure endpoint)
LLM_API_BASE=

# Optional: Embedding model (if semantic search/embedding is activated)
EMBEDDING_MODEL=text-embedding-3-small

# Offline & Air-gap safety settings (Mandatory Hard Rule 8)
LITELLM_LOCAL_MODEL_COST_MAP=True
LITELLM_TELEMETRY=False

# --- Database Configuration ---
POSTGRES_DB=ebuddy
POSTGRES_USER=ebuddy_user
POSTGRES_PASSWORD=ebuddy_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ebuddy_user:ebuddy_password@db:5432/ebuddy

# Local development fallback DATABASE_URL (for running scripts/tests on host without Docker)
LOCAL_DATABASE_URL=postgresql+psycopg://ebuddy_user:ebuddy_password@localhost:5432/ebuddy

# --- Application Configuration ---
APP_ENV=production
APP_PORT=8000
ADMINER_PORT=8080
LOG_LEVEL=INFO

