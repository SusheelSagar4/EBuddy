# ==============================================================================
# Personalised Learning Buddy (IIT Bhubaneswar) - environment template
# Copy to .env only if you want to change a default. `docker compose up` works without a .env file.
# Placeholders only: never commit real keys.
# ==============================================================================

# --- LLM gateway (all calls go through LiteLLM in app/llm/client.py) ---
# Model string passed to LiteLLM (e.g. openai/<model>, gemini/<model>, azure/<deployment>, ollama/<model>). "fake" = offline deterministic mode.
LLM_MODEL=fake
# Provider API key. Leave empty for offline deterministic mode.
LLM_API_KEY=
# Optional custom endpoint (LiteLLM proxy, Azure, Ollama). A local endpoint needs no key.
LLM_API_BASE=
# Embedding model passed to LiteLLM. Empty = deterministic local vectors.
EMBEDDING_MODEL=
# Seconds before one LLM call is abandoned and the deterministic fallback is used.
LLM_TIMEOUT_SECONDS=12
# Retries (with back-off) on rate limits and timeouts before falling back.
LLM_MAX_RETRIES=2
# Consecutive failures that open the circuit breaker.
LLM_BREAKER_THRESHOLD=3
# Seconds the circuit breaker stays open (no provider calls, fallback only).
LLM_BREAKER_COOLDOWN_SECONDS=60
# LiteLLM: use the bundled price map (no outbound fetch) and send no telemetry.
LITELLM_LOCAL_MODEL_COST_MAP=True
LITELLM_TELEMETRY=False

# --- Database (docker-compose.yml builds DATABASE_URL for the app container from these) ---
POSTGRES_DB=ebuddy
POSTGRES_USER=ebuddy_user
POSTGRES_PASSWORD=ebuddy_password
# Host port the db container is published on (127.0.0.1 only).
POSTGRES_HOST_PORT=5432
# Used when running the app or scripts outside Docker Compose.
DATABASE_URL=postgresql+psycopg://ebuddy_user:ebuddy_password@db:5432/ebuddy
# Fallback used when DATABASE_URL points at host "db" but the process is not in a container.
LOCAL_DATABASE_URL=postgresql+psycopg://ebuddy_user:ebuddy_password@localhost:5432/ebuddy
# auto = mirror state to PostgreSQL when reachable; off = seed files and memory only (used by the tests).
EBUDDY_DB_SYNC=auto
# Seconds between polls of ops.reprocess_queue for direct database (Adminer) edits.
REPROCESS_POLL_SECONDS=2

# --- Ports and application ---
# Host port of the web app and API.
APP_PORT=8000
# Host port of the bundled Adminer.
ADMINER_PORT=8080
# Optional. When set, state-changing admin requests (edits, reset) must send this value in the
# X-Admin-Token header; the web app asks for it once. Empty = admin endpoints are open (local demo).
ADMIN_TOKEN=
# Largest accepted request body in bytes (default 1 MiB); bigger requests get 413.
MAX_REQUEST_BYTES=1048576
# Read by app/config.py; not used elsewhere at present.
APP_ENV=production
LOG_LEVEL=INFO
